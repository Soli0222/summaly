{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'security:minimumReleaseAgeNpm',
    ':dependencyDashboard',
  ],
  pinDigests: false,
  timezone: 'Asia/Tokyo',
  rangeStrategy: 'bump',
  prConcurrentLimit: 20,
  prHourlyLimit: 10,
  reviewers: [
    'Soli0222',
  ],
  assignees: [
    'Soli0222',
  ],
  semanticCommits: 'enabled',
  prCreation: 'immediate',
  rebaseWhen: 'auto',
  dependencyDashboard: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
  packageRules: [
    {
      description: 'Keep TypeScript 6 until typescript-eslint supports TypeScript 7 (https://github.com/Soli0222/summaly/issues/174)',
      matchManagers: ['npm'],
      matchFileNames: ['package.json'],
      matchPackageNames: ['typescript'],
      allowedVersions: '<7',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      commitMessageTopic: 'GitHub Action {{depName}}',
      automerge: true,
    },
    {
      matchManagers: [
        'docker-compose',
        'dockerfile',
      ],
      matchDepNames: [
        '!node',
      ],
      commitMessageTopic: 'Docker {{depName}}',
      automerge: true,
    },
    {
      matchDepNames: [
        'node',
      ],
      groupName: 'node',
      commitMessageTopic: 'Node.js',
      automerge: true,
    },
    {
      matchManagers: [
        'npm',
      ],
      commitMessageTopic: 'Node {{depName}}',
      automerge: true,
    },
    {
      "description": "Track the latest stable Node.js release, including new majors before LTS.",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "versioning": "npm",
      "enabled": true,
      "ignoreUnstable": true,
      "separateMajorMinor": false,
      "automerge": true,
      "semanticCommitType": "fix"
    },
    {
      "description": "Do not delay runtime security updates; keep npm package cooldowns.",
      "matchPackageNames": [
        "node"
      ],
      "groupName": "Node.js",
      "minimumReleaseAge": "0 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Separate the Docker variant from the stable Node.js version.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "versionCompatibility": "^(?<version>[^-]+)(?<compatibility>-.*)?$"
    },
  ],
}
